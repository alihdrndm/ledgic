{
  "name": "ledgic",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source accounts-payable automation: AI extraction, three-way match, agents, RAG and MCP.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @ledgic/web dev",
    "build": "pnpm --filter @ledgic/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @ledgic/web test:e2e",
    "db:start": "npx supabase@latest start",
    "db:reset": "npx supabase@latest db reset",
    "db:test": "npx supabase@latest test db",
    "db:types": "npx supabase@latest gen types typescript --local > packages/db-types/src/database.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    }
  }
}
